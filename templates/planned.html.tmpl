<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>dash14 Overlay</title>
  <style>
    :root {
      --panel: rgba(8, 14, 24, 0.86);
      --panel-edge: rgba(255, 255, 255, 0.12);
      --home: #1d7fe3;
      --guest: #e14e3a;
      --accent: #f3c54b;
      --text: #f5f7fb;
      --muted: #b8c2d8;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 0 24px 48px;
      font-family: "Arial Narrow", sans-serif;
      color: var(--text);
    }

    .overlay {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      width: min(1120px, 100%);
      border-radius: 18px;
      overflow: hidden;
      background: linear-gradient(90deg, rgba(29, 127, 227, 0.18), rgba(225, 78, 58, 0.18)), var(--panel);
      border: 1px solid var(--panel-edge);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .team {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 18px;
      align-items: center;
      padding: 18px 22px;
    }

    .team.guest {
      grid-template-columns: 1fr auto;
    }

    .logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      border-radius: 8px;
    }

    .logo-placeholder {
      width: 72px;
      height: 72px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--panel-edge);
    }

    .meta {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    .guest .meta {
      text-align: right;
    }

    .role {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .name {
      font-size: 34px;
      font-weight: 800;
      line-height: 0.95;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .third-line {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .center {
      display: grid;
      place-items: center;
      min-width: 180px;
      padding: 18px 12px;
      background: linear-gradient(180deg, rgba(243, 197, 75, 0.12), rgba(243, 197, 75, 0.03));
      border-left: 1px solid var(--panel-edge);
      border-right: 1px solid var(--panel-edge);
    }

    .center-box {
      display: grid;
      gap: 6px;
      text-align: center;
    }

    .center-label {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .center-value {
      font-size: 36px;
      font-weight: 900;
      line-height: 1;
      color: var(--accent);
      text-transform: uppercase;
    }

    .status {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #f3c54b;
    }

    @media (max-width: 960px) {
      .overlay {
        grid-template-columns: 1fr;
      }

      .center {
        border-left: none;
        border-right: none;
        border-top: 1px solid var(--panel-edge);
        border-bottom: 1px solid var(--panel-edge);
      }
    }
  </style>
</head>
<body>
  <section class="overlay" aria-label="Upcoming match overlay">
    <article class="team home">
      {{if .HomeTeamLogoPath}}
      <img class="logo" src="{{.HomeTeamLogoPath}}" alt="{{.HomeTeamName}} logo">
      {{else}}
      <div class="logo-placeholder"></div>
      {{end}}
      <div class="meta">
        <div class="role">Home Team</div>
        <div class="name">{{.HomeTeamName}}</div>
        {{if .HomeTeamHometown}}<div class="third-line">{{.HomeTeamHometown}}</div>{{end}}
      </div>
    </article>

    <div class="center">
      <div class="center-box">
        <div class="center-label">Upcoming</div>
        <div class="center-value">Match</div>
        <div class="status">Soon</div>
      </div>
    </div>

    <article class="team guest">
      <div class="meta">
        <div class="role">Guest Team</div>
        <div class="name">{{.GuestTeamName}}</div>
        {{if .GuestTeamHometown}}<div class="third-line">{{.GuestTeamHometown}}</div>{{end}}
      </div>
      {{if .GuestTeamLogoPath}}
      <img class="logo" src="{{.GuestTeamLogoPath}}" alt="{{.GuestTeamName}} logo">
      {{else}}
      <div class="logo-placeholder"></div>
      {{end}}
    </article>
  </section>
  <script>
    window.setInterval(() => {
      window.location.reload();
    }, 2000);
  </script>
</body>
</html>
