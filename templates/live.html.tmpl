<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>dash14 Overlay</title>
  <style>
    :root {
      --panel: rgba(8, 14, 24, 0.86);
      --panel-edge: rgba(255, 255, 255, 0.12);
      --home: #1d7fe3;
      --guest: #e14e3a;
      --accent: #f3c54b;
      --text: #f5f7fb;
      --muted: #b8c2d8;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 0 24px 48px;
      font-family: "Arial Narrow", sans-serif;
      color: var(--text);
    }

    .overlay {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      width: min(1120px, 100%);
      border-radius: 18px;
      overflow: hidden;
      background: linear-gradient(90deg, rgba(29, 127, 227, 0.18), rgba(225, 78, 58, 0.18)), var(--panel);
      border: 1px solid var(--panel-edge);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .team {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: center;
      padding: 18px 22px;
    }

    .team.right-team {
      grid-template-columns: auto 1fr;
    }

    .meta {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    .right-team .meta {
      text-align: right;
    }

    .role {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .name {
      font-size: 26px;
      font-weight: 800;
      line-height: 0.95;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sets {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .sets strong {
      color: var(--accent);
      font-size: 28px;
    }

    .points {
      min-width: 126px;
      padding: 14px 16px 10px;
      border-radius: 16px;
      background: rgba(2, 7, 15, 0.78);
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .points-value {
      font-family: "Menlo", monospace;
      font-size: 64px;
      font-weight: 800;
      line-height: 1;
    }

    .points-label {
      margin-top: 4px;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .center {
      display: grid;
      place-items: center;
      min-width: 180px;
      padding: 18px 12px;
      background: linear-gradient(180deg, rgba(243, 197, 75, 0.12), rgba(243, 197, 75, 0.03));
      border-left: 1px solid var(--panel-edge);
      border-right: 1px solid var(--panel-edge);
    }

    .center-box {
      display: grid;
      gap: 6px;
      text-align: center;
    }

    .center-label {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .center-value {
      font-size: 58px;
      font-weight: 900;
      line-height: 1;
      color: var(--accent);
      text-transform: uppercase;
    }

    .status {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #9fe5b5;
    }

    @media (max-width: 960px) {
      .overlay {
        grid-template-columns: 1fr;
      }

      .center {
        border-left: none;
        border-right: none;
        border-top: 1px solid var(--panel-edge);
        border-bottom: 1px solid var(--panel-edge);
      }
    }
  </style>
</head>
<body>
  <section class="overlay" aria-label="Live game overlay">
    <article class="team left-team">
      <div class="meta">
        <div class="role">{{.LeftTeamLabel}}</div>
        <div class="name">{{.LeftTeamName}}</div>
        <div class="sets">Sets <strong>{{.LeftSetsWon}}</strong></div>
      </div>
      <div class="points">
        <div class="points-value">{{.LeftScore}}</div>
        <div class="points-label">Points</div>
      </div>
    </article>

    <div class="center">
      <div class="center-box">
        <div class="center-label">Current Set</div>
        <div class="center-value">{{.CurrentSetNumber}}</div>
        <div class="status">Live</div>
      </div>
    </div>

    <article class="team right-team">
      <div class="points">
        <div class="points-value">{{.RightScore}}</div>
        <div class="points-label">Points</div>
      </div>
      <div class="meta">
        <div class="role">{{.RightTeamLabel}}</div>
        <div class="name">{{.RightTeamName}}</div>
        <div class="sets">Sets <strong>{{.RightSetsWon}}</strong></div>
      </div>
    </article>
  </section>
<script>
    window.setInterval(() => {
      window.location.reload();
    }, 2000);
  </script>
</body>
</html>
