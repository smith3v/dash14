<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>dash14 Finished</title>
  <style>
    :root {
      --panel: rgba(8, 14, 24, 0.86);
      --panel-edge: rgba(255, 255, 255, 0.12);
      --accent: #f3c54b;
      --text: #f5f7fb;
      --muted: #b8c2d8;
      --table-row: rgba(255, 255, 255, 0.05);
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: transparent;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      font-family: "Arial Narrow", sans-serif;
      color: var(--text);
      box-sizing: border-box;
    }

    .panel {
      width: min(900px, 100%);
      display: grid;
      gap: 24px;
      padding: 28px 32px;
      border-radius: 22px;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(29, 127, 227, 0.16), rgba(225, 78, 58, 0.16)), var(--panel);
      border: 1px solid var(--panel-edge);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .headline {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: center;
    }

    .scoreline {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
      align-items: center;
      padding: 22px 24px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(243, 197, 75, 0.12), rgba(243, 197, 75, 0.03));
      border: 1px solid var(--panel-edge);
    }

    .team {
      display: grid;
      align-items: center;
      gap: 14px;
      grid-template-columns: auto 1fr;
      min-width: 0;
    }

    .team.right {
      text-align: right;
      grid-template-columns: 1fr auto;
    }

    .logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      border-radius: 8px;
    }

    .logo-placeholder {
      width: 72px;
      height: 72px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--panel-edge);
    }

    .meta {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    .team.right .meta {
      text-align: right;
    }

    .role {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .name {
      font-size: 34px;
      font-weight: 800;
      line-height: 0.95;
      text-transform: uppercase;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .sets {
      display: flex;
      align-items: baseline;
      gap: 14px;
      font-size: 64px;
      font-weight: 900;
      line-height: 1;
      color: var(--accent);
    }

    .divider {
      color: var(--text);
      opacity: 0.7;
    }

    .summary {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-align: center;
      color: var(--accent);
    }

    .history {
      display: grid;
      gap: 10px;
    }

    .set {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 12px;
      align-items: center;
      padding: 12px 18px;
      border-radius: 14px;
      background: var(--table-row);
      border: 1px solid var(--panel-edge);
    }

    .set-score {
      font-family: "Menlo", monospace;
      font-size: 36px;
      font-weight: 800;
      line-height: 1;
    }

    .set-score.guest {
      text-align: right;
    }

    .set-label {
      min-width: 120px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-align: center;
      text-transform: uppercase;
      color: var(--muted);
    }

    .empty-state {
      padding: 8px 0 4px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-align: center;
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (max-width: 720px) {
      body {
        padding: 16px;
      }

      .panel {
        padding: 22px 20px;
      }

      .scoreline {
        grid-template-columns: 1fr;
      }

      .team,
      .team.right {
        grid-template-columns: auto 1fr;
        text-align: left;
      }

      .sets {
        justify-content: center;
        font-size: 52px;
      }

      .set-label {
        min-width: 88px;
        font-size: 16px;
      }

      .set-score {
        font-size: 28px;
      }
    }
  </style>
</head>
<body>
  <section class="panel" aria-label="Finished game overlay">
    <div class="headline">Match Finished</div>

    <div class="scoreline">
      <div class="team">
        {{if .HomeTeamLogoPath}}
        <img class="logo" src="{{.HomeTeamLogoPath}}" alt="{{.HomeTeamName}} logo">
        {{else}}
        <div class="logo-placeholder"></div>
        {{end}}
        <div class="meta">
          <div class="role">Home Team</div>
          <div class="name">{{.HomeTeamName}}</div>
        </div>
      </div>

      <div class="sets">
        <span>{{.HomeSetsWon}}</span>
        <span class="divider">:</span>
        <span>{{.GuestSetsWon}}</span>
      </div>

      <div class="team right">
        <div class="meta">
          <div class="role">Guest Team</div>
          <div class="name">{{.GuestTeamName}}</div>
        </div>
        {{if .GuestTeamLogoPath}}
        <img class="logo" src="{{.GuestTeamLogoPath}}" alt="{{.GuestTeamName}} logo">
        {{else}}
        <div class="logo-placeholder"></div>
        {{end}}
      </div>
    </div>

    <div class="summary">Final Score</div>

    <div class="history">
      {{if .SetScores}}
      {{range .SetScores}}
      <div class="set">
        <div class="set-score">{{.HomeScore}}</div>
        <div class="set-label">Set {{.SetNumber}}</div>
        <div class="set-score guest">{{.GuestScore}}</div>
      </div>
      {{end}}
      {{else}}
      <div class="empty-state">No completed sets recorded</div>
      {{end}}
    </div>
  </section>
  <script>
    window.setInterval(() => {
      window.location.reload();
    }, 2000);
  </script>
</body>
</html>
